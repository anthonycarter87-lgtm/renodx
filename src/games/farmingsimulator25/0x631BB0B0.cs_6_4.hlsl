// FS25 cloud temporal reprojection: builds the full sky/cloud buffer from a quarter-size sub-frame each frame
// (2x2 interleave) plus reprojected history. Decompiled with the state-machine control-flow mode; dx.op counts
// match the original. RenoDX: with Cloud Reconstruction on, history is neighbourhood-clamped for all pixels.
#include "./shared.h"

