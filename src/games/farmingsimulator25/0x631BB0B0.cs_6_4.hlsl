// Same 3x3 Gaussian-weighted mean +/- standard deviation the game uses to clip history for re-rendered pixels.
void ClampCloudHistory(int2 center, inout float4 inscatter, inout float transmittance_x, inout float transmittance_y) {
  const int2 max_coord = int2(g_subFrameSize) - 1;
  float3 sum = 0.f;
  float3 sum_sq = 0.f;
  float2 t_sum = 0.f;
  float2 t_sum_sq = 0.f;
  [unroll]
  for (int y = -1; y <= 1; ++y) {
    [unroll]
    for (int x = -1; x <= 1; ++x) {
      const int2 coord = clamp(center + int2(x, y), 0, max_coord);
      const float weight = (x == 0 && y == 0) ? 1.f : ((x == 0 || y == 0) ? 0.4723665416240692f : 0.22313016653060913f);
      const float3 s = skyInScatteringSubFrame.Load(int3(coord, 0)).xyz;
      const float2 t = skyTransmittanceSubFrame.Load(int3(coord, 0)).xy;
      sum += s * weight;
      sum_sq += s * s * weight;
      t_sum += t * weight;
      t_sum_sq += t * t * weight;
    }
  }
  const float3 mean = sum * 0.2644112706184387f;
  const float3 sigma = sqrt(max(sum_sq * 0.2644112706184387f - mean * mean, 0.f));
  const float2 t_mean = t_sum * 0.2644112706184387f;
  const float2 t_sigma = sqrt(max(t_sum_sq * 0.2644112706184387f - t_mean * t_mean, 0.f));
  inscatter.xyz = clamp(inscatter.xyz, mean - sigma, mean + sigma);
  transmittance_x = clamp(transmittance_x, t_mean.x - t_sigma.x, t_mean.x + t_sigma.x);
  transmittance_y = clamp(transmittance_y, t_mean.y - t_sigma.y, t_mean.y + t_sigma.y);
}

